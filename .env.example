# Base de données — RDS PostgreSQL eu-central-2 (Zurich), voir docs/aws-setup-base.md
DATABASE_URL="postgresql://vulcain:MOT_DE_PASSE@ENDPOINT:5432/vulcain?sslmode=require"

# NextAuth — générer avec : openssl rand -base64 32
AUTH_SECRET=""

# Cloudflare Turnstile — clés de test ci-dessous (passent toujours).
# En production : créer un site sur dash.cloudflare.com/turnstile et remplacer.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Upstash Redis — rate limiting des commandes. Optionnel en dev (désactivé si absent),
# OBLIGATOIRE en production : créer une base sur console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
