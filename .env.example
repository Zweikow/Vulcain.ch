# Base de données — RDS PostgreSQL eu-central-2 (Zurich), voir docs/aws-setup-base.md
DATABASE_URL="postgresql://vulcain:MOT_DE_PASSE@ENDPOINT:5432/vulcain?sslmode=require"

# NextAuth — générer avec : openssl rand -base64 32
AUTH_SECRET=""

# Cloudflare Turnstile — clés de test ci-dessous (passent toujours).
# En production : créer un site sur dash.cloudflare.com/turnstile et remplacer.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Upstash Redis — rate limiting des commandes. Optionnel en dev (désactivé si absent),
# OBLIGATOIRE en production : créer une base sur console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Emails transactionnels — Amazon SES, voir docs/aws-setup-ses.md
# MAIL_FROM vide = les emails sont écrits dans la console au lieu d'être envoyés.
AWS_REGION="eu-central-2"
MAIL_FROM=""
# Authentification en développement, au choix :
#  - recommandé : profil SSO Identity Center, aucun secret sur le disque
#    (aws configure sso --profile vulcain, puis décommenter la ligne ci-dessous)
# AWS_PROFILE="vulcain"
#  - ou clés d'un utilisateur IAM limité à ses:SendEmail, à supprimer une fois
#    le déploiement en place. En production : rôle IAM d'exécution, pas de clé.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Utilisée dans la notification à la cidrerie pour lier la commande au back-office
ADMIN_BASE_URL="http://localhost:3000"

# Visuels Instagram — GET /api/instagram/<numéro d'article ou id>
# Secret exigé dans l'en-tête « x-render-secret ». Valeur longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INSTAGRAM_RENDER_SECRET=""
# Adresse d'où la route télécharge packshots et logo en HTTP. Vide : adresse de
# la requête elle-même. En local : http://localhost:3000
INSTAGRAM_ASSET_BASE_URL="http://localhost:3000"

# Paiement en ligne PostFinance Checkout (Payment Page + webhook signé),
# voir le wiki « Paiement PostFinance ». Valeurs ci-dessous FACTICES.
# En local : copier ces lignes dans .env.local (jamais commité) avec les
# identifiants de l'utilisateur d'application du space de TEST.
# PFC_ENABLED à "true" pour proposer le paiement en ligne ; tout autre valeur
# garde la commande sur facture.
PFC_ENABLED="false"
PFC_SPACE_ID="00000"
PFC_USER_ID="000000"
PFC_AUTH_KEY="cle-factice-a-remplacer"
# Choix du mode sur le formulaire et facture PowerPay. Le mapping relie chaque
# mode aux IDs de configuration de modes de paiement du space (propres à chaque
# space : jamais dans le code). IDs FACTICES ci-dessous.
PFC_MODE_CHOICE_ENABLED="false"
PFC_INVOICE_ENABLED="false"
PFC_PAYMENT_MODES='{"CARTE":[0],"POSTFINANCE_CARD":[0],"POSTFINANCE_PAY":[0],"TWINT":[0],"FACTURE":[0]}'
