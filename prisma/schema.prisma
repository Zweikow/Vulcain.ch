// Modèle de données Cidrerie du Vulcain — v2 (règles DESIGN.md).
// Tous les montants sont en centimes entiers (Int) : jamais de flottant ni de
// Decimal, ni en base ni côté application. Les calculs vivent dans lib/money.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id             String          @id @default(cuid())
  name           String
  description    String?
  priceCents     Int // prix public TTC — le prix pro est dérivé du taux Setting, jamais stocké
  stock          Int             @default(0)
  stockSeuil     Int             @default(5)
  active         Boolean         @default(true) // visibilité boutique
  archived       Boolean         @default(false) // un produit cité dans une commande ne se supprime pas
  imageUrl       String?
  year           Int?
  category       Category        @relation(fields: [categoryId], references: [id])
  categoryId     String
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Le tarif pro appartient au client, pas à la commande (DESIGN.md §2).
model Customer {
  id               String   @id @default(cuid())
  email            String   @unique
  firstName        String
  lastName         String
  phone            String?
  address          String
  npa              String
  city             String
  isPro            Boolean  @default(false)
  acceptsMarketing Boolean  @default(false)
  createdAt        DateTime @default(now())
  orders           Order[]
}

enum ClientType {
  PRIVE
  PRO
}

model Order {
  id     String      @id @default(cuid())
  numero String      @unique // CMD-2026-0023 — série commande, attribuée à la prise de commande
  status OrderStatus @default(A_TRAITER)
  // Série facture, distincte et attribuée seulement à l'émission : une commande
  // annulée ne doit pas créer de trou dans la numérotation des factures.
  invoiceNumber String?   @unique // FAC-2026-0007
  invoicedAt    DateTime?
  clientType     ClientType      @default(PRIVE) // figé au moment de la commande
  customer       Customer?       @relation(fields: [customerId], references: [id])
  customerId     String?
  // Instantané des coordonnées : la commande reste lisible même si la fiche client change
  clientName     String
  clientEmail    String
  clientPhone    String?
  address        String
  npa            String
  city           String
  subtotalCents  Int // somme des lignes au prix appliqué
  discountCents  Int             @default(0) // remise pro totale, pour affichage
  shippingCents  Int             @default(0) // port facturé, figé au moment de la commande
  totalCents     Int
  vatCents       Int             @default(0) // TVA incluse, informative
  deliveryDate   DateTime?
  message        String?
  shippedAt      DateTime?
  cancelledAt    DateTime?
  cancelReason   String? // motif consigné : le client rappelle souvent des mois après
  items          OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OrderItem {
  id             String  @id @default(cuid())
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  product        Product @relation(fields: [productId], references: [id])
  productId      String
  productName    String  @default("") // instantané : la facture ne change pas si le produit change
  listPriceCents Int // prix public au moment de la commande
  unitPriceCents Int // prix appliqué (public ou pro)
  quantity       Int
}

enum OrderStatus {
  A_TRAITER
  EN_PREPARATION
  EXPEDIEE
  ANNULEE
}

enum StockMovementReason {
  COMMANDE
  ANNULATION
  AJUSTEMENT
  REASSORT
}

model StockMovement {
  id        String              @id @default(cuid())
  product   Product             @relation(fields: [productId], references: [id])
  productId String
  order     Order?              @relation(fields: [orderId], references: [id])
  orderId   String?
  delta     Int // négatif pour une sortie
  reason    StockMovementReason
  createdAt DateTime            @default(now())
}

// Réglages globaux — une seule ligne (id = 1). Port, franco et taux pro sont
// TOUJOURS lus ici, jamais codés en dur (bug historique : 10 CHF dans Cart.tsx).
model Setting {
  id              Int    @id @default(1)
  proRatePercent  Int    @default(20) // remise pro en % entier, appliquée à tout le catalogue
  shippingCents   Int    @default(1000) // port standard
  francoCents     Int    @default(12000) // seuil de livraison offerte (bandeau actuel : 120 CHF)
  prepDays        Int    @default(3) // jours de préparation annoncés
  companyName     String @default("Cidrerie du Vulcain")
  companyAddress  String @default("Ch. des Moilles 16")
  contactEmail    String @default("commandes@cidrerie-vulcain.ch")
  contactPhone    String @default("")
  vatNumber       String @default("") // ex. CHE-123.456.789 TVA
  vatRatePermille Int    @default(81) // TVA 8.1% incluse dans les prix affichés
  iban            String @default("CH57 0900 0000 1703 3189 6")
  // En-tête et pied de la facture papier (modèle Facture_Base.docx)
  contactName      String @default("Bertrand Baeriswyl") // signataire de la facture
  companyTagline   String @default("Distribution Cidrerie du Vulcain CH")
  companyZipCity   String @default("1619 Les Paccots")
  invoicePlace     String @default("Les Paccots") // « Les Paccots, le … »
  bankName         String @default("PostFinance AG")
  paymentTermsDays Int    @default(30) // « Facture payable à 30 jours net »
}

// Compteur de numérotation par série et par année — incrément atomique en
// transaction. Séries : CMD (commandes), FAC (factures), AV (avoirs, à venir).
// Une série par année : la remise à zéro annuelle est admise partout, à
// condition que chaque série reste continue sur l'année.
model DocumentCounter {
  series String
  year   Int
  value  Int    @default(0)

  @@id([series, year])
}
